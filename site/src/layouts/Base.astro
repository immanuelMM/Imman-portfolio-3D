---
import '../styles/layers.css'
import '../styles/print.css'
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import groteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url'
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
import CvButtons from '../components/CvButtons.astro'
import Nav from '../components/Nav.astro'
import ScenePoster from '../components/ScenePoster.astro'
import { profile } from '../data/profile'
import { buildSeo, safeJsonLd } from '../lib/seo'

interface Props {
  title: string
  description: string
  name: string
}

const { title, description, name } = Astro.props
const seo = buildSeo({
  site: Astro.site ?? new URL('http://localhost'),
  base: import.meta.env.BASE_URL,
  pathname: Astro.url.pathname,
  title,
  description,
  person: { name, jobTitle: profile.title, sameAs: [profile.github] },
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07090d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A dark server room lit by cyan holographic panels." />
    <meta property="og:site_name" content={name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={seo.ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={safeJsonLd(seo.jsonLd)} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <link rel="icon" href={seo.favicon} type="image/svg+xml" />
    <link rel="preload" href={groteskUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <style
      set:html={`
      @font-face{font-family:'Space Grotesk Variable';font-style:normal;font-display:swap;font-weight:300 700;src:url(${groteskUrl}) format('woff2-variations')}
      @font-face{font-family:'Space Grotesk Fallback';src:local('Arial');size-adjust:104%;ascent-override:94%;descent-override:26%;line-gap-override:0%}
      @font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interUrl}) format('woff2-variations')}
      @font-face{font-family:'Inter Fallback';src:local('Arial');size-adjust:107.4%;ascent-override:90.2%;descent-override:22.5%;line-gap-override:0%}
      @font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url(${monoUrl}) format('woff2-variations')}
    `}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div id="scene" data-scene-state="loading" data-chapter="about" aria-hidden="true">
      <ScenePoster />
      <div id="scene-canvas"></div>
    </div>
    <Nav name={name} />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <CvButtons variant="bar" />
    <p id="cv-toast" class="cv-toast" role="status" aria-live="polite"></p>
    <slot name="print" />
    <slot name="dialogs" />
    <script>
      import '../scripts/sceneBoot'
      import '../scripts/activeSection'
      import '../scripts/navMenu'
      import '../scripts/cvDownload'
      import '../scripts/agentCards'
      import '../scripts/expand'
      import '../scripts/glass'
      import '../scripts/highlightLinks'
    </script>
  </body>
</html>
