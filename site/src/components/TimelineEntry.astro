---
import type { Entry } from '../data'

interface Props {
  entry: Entry
}
const { entry } = Astro.props
---

<li class="timeline__item">
  <p class="timeline__period">{entry.period}</p>
  <h3>{entry.role}</h3>
  <p class="timeline__org">{entry.org}</p>
  {entry.bullets.length > 0 && (
    <ul class="bullets">
      {entry.bullets.map((b) => (
        <li>{b}</li>
      ))}
    </ul>
  )}
</li>
