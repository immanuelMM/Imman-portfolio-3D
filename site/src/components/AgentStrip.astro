---
import { agents, WORKFLOW_STEPS } from '../data'

// Workflow order: Lead -> Planner -> Backend and Frontend in parallel -> QA -> Docs -> DevOps.
const byId = Object.fromEntries(agents.map((a) => [a.id, a]))
const steps = WORKFLOW_STEPS.map((ids) => ids.map((id) => byId[id]))
---

<div class="agents">
  <h3 id="agents-title">The seven-agent workflow</h3>
  <p class="agents__lead">
    Each project below is built by a team of specialised Claude Code agents, in this order. Select an agent for its
    details.
  </p>
  <ol class="agents__steps" aria-labelledby="agents-title">
    {steps.map((group, i) => (
      <li class="agents__step">
        <span class="agents__num" aria-hidden="true">
          {i + 1}
        </span>
        <ul class:list={['agents__group', { 'agents__group--parallel': group.length > 1 }]}>
          {group.map((a) => (
            <li>
              <button type="button" class="agent" data-agent={a.id} data-hl={`agent:${a.id}`} aria-haspopup="dialog">
                <strong>{a.name}</strong>
                <span class="agent__role">{a.role}</span>
                <span class="agent__more" aria-hidden="true">
                  Details
                </span>
                <span class="sr-only">Open details</span>
              </button>
            </li>
          ))}
        </ul>
        {group.length > 1 && <span class="sr-only">These two work in parallel.</span>}
      </li>
    ))}
  </ol>
</div>
