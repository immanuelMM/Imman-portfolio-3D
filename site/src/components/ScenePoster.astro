---
/**
 * The poster is the first picture, the no-WebGL fallback and the picture after a context loss. It is a real render of the
 * About frame (scripts/capture-poster.mjs: reduced-motion still, a landscape, a tablet-portrait and a phone-portrait crop,
 * chosen by aspect ratio in features.css). The scene never reads it.
 */
import { withBase } from '../lib/withBase'

const landscape = withBase('poster/poster-hero-desktop.webp')
const tablet = withBase('poster/poster-hero-tablet.webp')
const phone = withBase('poster/poster-hero-phone.webp')
---

<div
  class="scene-poster"
  style={`--poster-landscape:url(${landscape});--poster-tablet:url(${tablet});--poster-phone:url(${phone})`}
></div>
